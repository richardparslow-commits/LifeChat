# LifeChat — environment configuration template
# Copy this file to .env and fill in your own values.
# Never commit the real .env file (it is gitignored).

# Port to listen on. LIFECHAT_PORT wins; if it is unset, PORT is used, so the
# app binds the port a hosting platform or sandbox injects. Default 3000.
LIFECHAT_PORT=3000
# PORT=3000

BUSINESS_NAME="Life Policy Pilot"
LICENSED_BROKER_NAME="Richard Parslow"
TEXAS_LICENSE_NUMBER="[Your Texas license number from compliance]"
APPOINTED_CARRIERS="" # comma-separated allowlist; never imply coverage beyond it
WEBSITE_URL="https://lifepolicypilot.blog/"
PRIVACY_NOTICE_URL="https://lifepolicypilot.blog/privacy/"
CONTACT_URL="https://lifepolicypilot.blog/contact/"
PRIVACY_NOTICE_VERSION="1.0.0"
CONTACT_CONSENT_VERSION="1.0.0"
DSR_EMAIL="privacy@lifepolicypilot.blog" # data subject requests (TDPSA rights)

# LLM provider (OpenAI-compatible). Set LLM_API_BASE_URL to your proxy/gateway
# if needed. With no LLM_API_KEY the app still starts and answers from the
# static safe fallback — useful for a sandbox with no credentials.
LLM_API_BASE_URL="https://api.openai.com/v1"
LLM_MODEL="gpt-4o"
LLM_API_KEY="your-api-key-here"

PILOT_MODE=true

# Phase 2 medical lead capture — KEEP DISABLED until Texas insurance counsel
# approves the medical consent flow (docs/medical-lead-capture-phase2.md).
# Flip to false only after approval; the chat endpoint then honors the
# consented medical fact-finding states.
HEALTH_DATA_COLLECTION_DISABLED=true

# Feature kill switches (each defaults to enabled; set false to roll back
# without a code change).
CONTEXTUAL_BRIDGE_ENABLED=true # contextual content bridge (opening message + RAG)
VISUAL_CARDS_ENABLED=true # pre-approved display-only educational cards
ABSTENTION_LOGGING_ENABLED=true # hashed, non-PII JSONL feed for content strategy
ABSTENTION_LOG_PATH="data/abstention-log.jsonl"
FREE_OFFER_MARKETING_APPROVED=false # blocks "free quote"/no-obligation phrasing until marketing review

# Cross-origin embed allowlist for the widget's data-server-url pattern.
# Empty = same-origin only (the bundled demo page). When the widget is embedded
# on the blog, list that origin exactly, comma-separated, e.g.
# ALLOWED_ORIGINS="https://lifepolicypilot.blog"
ALLOWED_ORIGINS=""

# Admin API key — protects admin/internal endpoints (system prompt, session
# history, session count, DSR status) and the runtime kill switch
# (POST/DELETE /api/admin/kill-switch). Required in production
# (PILOT_MODE=false); optional in pilot mode for dev convenience. Clients send
# it as the x-admin-key header.
ADMIN_API_KEY=""

# Where DSR records are persisted (append-only JSONL). Survives restarts so
# TDPSA 45-day response obligations are not lost. Override for serverless
# read-only filesystems.
DSR_LOG_PATH="data/dsr-records.jsonl"

# Where consent/lead records are persisted (append-only JSONL). Lead records
# and their consent artifacts are legal records (TDPSA retention, consent
# proof) that must survive restarts.
LEAD_LOG_PATH="data/lead-records.jsonl"

# At-rest encryption for DSR and lead record logs (AES-256-GCM). REQUIRED in
# production (PILOT_MODE=false); without it the app refuses to start so
# PII-bearing record logs are never written in plaintext in production.
# Optional in pilot mode where records fall back to plaintext for dev.
RECORD_ENCRYPTION_KEY=""
