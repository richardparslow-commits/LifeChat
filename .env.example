# LifeChat — environment configuration template
# Copy this file to .env and fill in your own values.
# Never commit the real .env file (it is gitignored).

# Port to listen on. LIFECHAT_PORT wins; if it is unset, PORT is used, so the
# app binds the port a hosting platform or sandbox injects. Default 3000.
LIFECHAT_PORT=3000
# PORT=3000

BUSINESS_NAME="LifeChat" # the assistant/product; the provider is Life Insurance Broker Advocate
LICENSED_BROKER_NAME="Richard Parslow"
# The pre-deploy gate rejects templates such as this one, and production startup
# refuses to serve the pending sentinel; set the verified TDI number.
TEXAS_LICENSE_NUMBER="[Your Texas license number from compliance]"
APPOINTED_CARRIERS="" # comma-separated allowlist; never imply coverage beyond it
WEBSITE_URL="https://lifeinsurancebrokeradvocate.com/"
PRIVACY_NOTICE_URL="https://lifeinsurancebrokeradvocate.com/privacy"
CONTACT_URL="https://lifeinsurancebrokeradvocate.com/contact"
PRIVACY_NOTICE_VERSION="1.0.0"
# Consent artefacts store a hash of the exact copy affirmed, so these versions
# move with the copy. 1.1.0 is the LifeChat / Life Insurance Broker Advocate
# naming; the previous 1.0.0 copy named the retired product brand. Signed off
# for use by the principal owner and licensed broker (Richard Parslow) on
# 2026-10-23.
CONTACT_CONSENT_VERSION="1.1.0"
# Current medical consent version. The route ignores the value in the request
# and stores only this one; any other value is not current consent.
MEDICAL_CONSENT_VERSION="1.1.0"
# Published privacy-rights address: access, deletion, correction, portability
# and consent withdrawal (TDPSA). This is the ONE name for that address —
# /api/disclosure, /api/consent-text, the DSR receipt and the just-in-time
# notice all serve it. DSR_EMAIL is still accepted for existing deployments.
#
# This mailbox is permanent: it is not scheduled to move to another domain, so
# a future release does not need to chase it. What must hold is that the domain
# accepts mail — a request sent to an unroutable address bounces while the
# 45-day statutory clock is already running.
#
# `npm run rights:channel` proves the configured domain accepts mail:
#   exit 0 deliverable (or skipped) · 1 undeliverable · 2 unverified
# An MX record passes. No MX at all fails (exit 1). A domain with only an
# A/AAAA record reports unverified (exit 2): that host is an implicit MX
# (RFC 5321 §5.1) only if it accepts SMTP, which DNS cannot show. Offline
# preview builds can set DSR_CHANNEL_CHECK=off (skip) or run with
# --allow-offline (unverified is tolerated); a release must not use either.
DSR_CONTACT_EMAIL="richardparslow@lifepolicypilot.blog"

# LLM provider (OpenAI-compatible). Set LLM_API_BASE_URL to your proxy/gateway
# if needed. With no LLM_API_KEY the app still starts and answers from the
# static safe fallback — useful for a sandbox with no credentials.
LLM_API_BASE_URL="https://api.openai.com/v1"
LLM_MODEL="gpt-4o"
# A template like this one is rejected by the pre-deploy gate.
LLM_API_KEY="your-api-key-here"

PILOT_MODE=true

# Phase 2 medical lead capture — KEEP DISABLED until Texas insurance counsel
# approves the medical consent flow (docs/medical-lead-capture-phase2.md).
# Flip to false only after approval; the chat endpoint then honors the
# consented medical fact-finding states.
HEALTH_DATA_COLLECTION_DISABLED=true

# Feature kill switches (each defaults to enabled; set false to roll back
# without a code change).
CONTEXTUAL_BRIDGE_ENABLED=true # contextual content bridge (opening message + RAG)
VISUAL_CARDS_ENABLED=true # pre-approved display-only educational cards
ABSTENTION_LOGGING_ENABLED=true # keyed-hash, non-PII JSONL feed for content strategy
ABSTENTION_LOG_PATH="data/abstention-log.jsonl"
# Secret that keys the abstention question hash (openssl rand -hex 32). Without
# it no abstention is recorded, because an unkeyed digest of a question like
# "I have HIV" can be reversed by dictionary lookup. Rotating it starts a new
# dedup window; the log records a key id, never the key.
ABSTENTION_LOG_KEY=""
FREE_OFFER_MARKETING_APPROVED=false # blocks "free quote"/no-obligation phrasing until marketing review

# Cross-origin embed allowlist for the widget (window.LPP_CHAT_CONFIG.apiBase /
# data-api-base). Empty = same-origin only (the bundled demo page).
# List every origin that will host the widget, comma-separated. The live site
# needs the apex AND www because they are separate browser origins:
# ALLOWED_ORIGINS="https://lifeinsurancebrokeradvocate.com,https://www.lifeinsurancebrokeradvocate.com"
#
# Lovable preview deployments are https://<id>.lovable.app and
# https://<id>.lovableproject.com. Every preview mints a new subdomain, so add
# the exact origin of the preview under test and remove it when testing ends.
#
# A single-label wildcard (`https://*.lovable.app`) is still accepted by
# isAllowedOrigin — https-only, at least one label, never the bare vendor
# domain — but it admits EVERY project on that domain, not only yours: any
# Lovable tenant could spend this API's model budget and post consent and DSR
# records. Boot now warns when one is configured. Production lists exact
# origins only.
# ALLOWED_ORIGINS="https://lifeinsurancebrokeradvocate.com,https://www.lifeinsurancebrokeradvocate.com"
ALLOWED_ORIGINS=""

# Proxy trust (SEC-10). req.ip is the key for the chat spend budget and the
# write-endpoint budgets. Empty = trust no proxy, so req.ip is the socket
# address and X-Forwarded-For is ignored. On Vercel (VERCEL=1) an empty value
# resolves to one hop automatically, because the platform's edge is the only
# proxy and the address it forwards is the visitor's. Set it explicitly
# elsewhere: a hop count (`1`), an express keyword (`loopback`), or a
# comma-separated subnet/IP list you control.
#
#   1  Vercel alone, nginx/ALB in front, Cloud Run
#   2  Cloudflare in front of Vercel
#   "" local/container with no proxy
#
# `TRUST_PROXY=true` is refused: it would trust a caller-supplied header, so any
# caller could mint a fresh client budget. An unparseable value is ignored
# with a warning, so no proxy is trusted.
TRUST_PROXY=""

# Admin API key — protects admin/internal endpoints (system prompt, session
# history, session count, DSR status, lead export) and the runtime kill switch
# (POST/DELETE /api/admin/kill-switch). Required in every mode: when it is
# absent every admin route answers 503, including in pilot. Clients send it as
# the x-admin-key header. Must be at least 32 characters — a shorter key refuses
# to start, because it is the only credential in front of the admin surface.
# Generate with: openssl rand -base64 48
ADMIN_API_KEY=""

# Where DSR records are persisted (append-only JSONL). Survives restarts so
# TDPSA 45-day response obligations are not lost. Override for serverless
# read-only filesystems.
DSR_LOG_PATH="data/dsr-records.jsonl"

# Where consent/lead records are persisted (append-only JSONL). Lead records
# and their consent artifacts are legal records (TDPSA retention, consent
# proof) that must survive restarts.
#
# On a serverless runtime the app verifies at boot that each record directory
# accepts a write, a read-back and a delete outside an ephemeral root (/tmp,
# the OS temp dir, /var/task). If that probe fails, record writes answer 503
# instead of acknowledging a record that a cold start would lose. Point these
# paths at a durable mount or configure Archil; DURABLE_STORAGE_CONFIGURED is
# ignored because it asserted durability without proving it.
LEAD_LOG_PATH="data/lead-records.jsonl"

# Derived, PII-free session → lead index (session_id, lead_id, created_at
# only). A chat turn resolves a session's consent from this file instead of
# decrypting the whole lead log. Defaults to the lead log's path with a
# -session-index suffix; the server rebuilds it when it is missing or older
# than the log, and `npm run records:index-sessions` rebuilds it on demand.
LEAD_SESSION_INDEX_PATH="data/lead-records-session-index.jsonl"

# Where PII-free lead-access audit entries are appended. Every admin export
# records the page size, offsets, returned lead ids and suppression count —
# never a name, address or phone number. If this write fails the export is
# refused, so records cannot leave unlogged. Keep it in the same durable
# location as the records it describes.
LEAD_ACCESS_LOG_PATH="data/lead-access-log.jsonl"

# Where PII-free admin read-access entries are appended. Every operator read
# (session history, DSR status, system prompt, RAG search, session count,
# readiness) records the route, a hash prefix of the admin key, an opaque record
# id and the status — never the key, a query, or record content. An admin read
# is refused (503) if this write fails, so a disclosure cannot go unlogged.
ADMIN_ACCESS_LOG_PATH="data/admin-access-log.jsonl"

# Where PII-free erasure/retention audit entries are appended (request ids,
# timestamps and counts only — never an address). See
# docs/data-lifecycle-runbook.md.
ERASURE_LOG_PATH="data/erasure-log.jsonl"

# Directory holding the appointment ledger: one claim file per booked slot,
# created with O_CREAT|O_EXCL so two instances cannot confirm the same slot.
# It must be a POSIX filesystem shared by every instance that books. On a
# serverless runtime the path must be absolute and outside /tmp, the OS temp
# dir and /var/task, otherwise booking answers storage_unavailable rather than
# promising an appointment the invocation cannot keep. Archil's object (S3)
# mode cannot host this ledger — it has no conditional create — so use a
# mounted volume or the Archil Sandbox root disk.
BOOKING_LEDGER_PATH="data/bookings"

# Retention period in days for lead records and fulfilled DSR tombstones.
# Default 2555 (seven years); counsel owns the value. Enforced only by the
# operator-triggered sweep (`npm run data:lifecycle -- retention`), never in a
# request path. Open DSRs and records without a parseable timestamp are kept.
DATA_RETENTION_DAYS="2555"

# Archil disk storage (optional, server-only). When both ARCHIL_API_KEY and
# ARCHIL_DISK_ID are set, DSR, lead, and abstention JSONL logs are persisted to
# the Archil disk via its S3-compatible object API (and /api/consent + /api/dsr
# remain active on serverless runtimes). Note: ARCHIL_API_KEY must be an API key
# starting with key- (not a disk mount token adt_…), and ARCHIL_REGION must
# match the disk's region (e.g. aws-us-east-1).
ARCHIL_API_KEY=""
ARCHIL_REGION="aws-us-east-1"
ARCHIL_DISK_ID=""

# At-rest encryption for DSR and lead record logs (AES-256-GCM). REQUIRED in
# production (PILOT_MODE=false); without it the app refuses to start so
# PII-bearing record logs are never written in plaintext in production.
# Optional in pilot mode for contact-only records, which fall back to plaintext
# for dev. A consented medical profile is different: it is refused (503) unless
# this key is set, in pilot mode too. Must be at least 32 characters when set —
# a shorter key refuses to start in every mode.
# Generate with: openssl rand -base64 48
RECORD_ENCRYPTION_KEY=""

# Previous record-encryption secrets, comma-separated, used only to decrypt
# records written before a rotation. Each key's id is derived from the key, so
# nothing else has to be tracked. Rotate with: set the new secret above, list
# the old one here, deploy, then run `npm run records:rekey` and remove the old
# secret. Without this ring, a rotated key makes every prior record unreadable.
RECORD_ENCRYPTION_KEYS=""
